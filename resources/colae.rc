// Colae - Copyright (c) 2026 Nikao1 (github.com/Nikao1) - licenca MIT
// Recursos do Colae.exe: icone e informacoes de versao
// (as que aparecem em botao direito > Propriedades > Detalhes).
//
// Executaveis com essas informacoes preenchidas parecem menos
// "suspeitos" para antivirus do que um .exe anonimo.

#include <winver.h>
#include "version.h"

1 ICON "colae.ico"

// Textos com acento (Colaê) em UTF-8.
#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     STREAM_APP_VERSION_MAJOR, STREAM_APP_VERSION_MINOR, STREAM_APP_VERSION_PATCH, 0
 PRODUCTVERSION  STREAM_APP_VERSION_MAJOR, STREAM_APP_VERSION_MINOR, STREAM_APP_VERSION_PATCH, 0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName",      "Nikao1"
            VALUE "LegalCopyright",   "© 2026 Nikao1 - licença MIT"
            VALUE "FileDescription",  "Colaê - tela, som e voz direto entre amigos"
            VALUE "FileVersion",      STREAM_APP_VERSION
            VALUE "InternalName",     "Colae"
            VALUE "OriginalFilename", "Colae.exe"
            VALUE "ProductName",      "Colaê"
            VALUE "ProductVersion",   STREAM_APP_VERSION
            VALUE "Comments",         "https://github.com/Nikao1/stream-project"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        // 0x0416 = portugues (Brasil), 1200 = Unicode
        VALUE "Translation", 0x0416, 1200
    END
END
