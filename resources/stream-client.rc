// Recursos do stream-client.exe: icone e informacoes de versao
// (as que aparecem em botao direito > Propriedades > Detalhes).
//
// Executaveis com essas informacoes preenchidas parecem menos
// "suspeitos" para antivirus do que um .exe anonimo.

#include <winver.h>
#include "version.h"

1 ICON "stream-client.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     STREAM_APP_VERSION_MAJOR, STREAM_APP_VERSION_MINOR, STREAM_APP_VERSION_PATCH, 0
 PRODUCTVERSION  STREAM_APP_VERSION_MAJOR, STREAM_APP_VERSION_MINOR, STREAM_APP_VERSION_PATCH, 0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName",      "Stream Project"
            VALUE "FileDescription",  "Stream Project - Transmitir"
            VALUE "FileVersion",      STREAM_APP_VERSION
            VALUE "InternalName",     "stream-client"
            VALUE "OriginalFilename", "stream-client.exe"
            VALUE "ProductName",      "Stream Project"
            VALUE "ProductVersion",   STREAM_APP_VERSION
            VALUE "Comments",         "https://github.com/Nikao1/stream-project"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        // 0x0416 = portugues (Brasil), 1200 = Unicode
        VALUE "Translation", 0x0416, 1200
    END
END
